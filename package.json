{
  "name": "snake-army",
  "private": true,
  "version": "0.2.1",
  "description": "贪吃蛇 · Canvas 版，用 Tauri 打包成桌面程序；前端本身仍是纯静态页面",
  "scripts": {
    "sync": "node scripts/sync-web.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "probe": "node scripts/probe-web.mjs",
    "fetch:easytier": "node scripts/fetch-easytier.mjs",
    "pack": "node scripts/pack-exe.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "pack:netlify": "node scripts/pack-netlify.mjs",
    "bump": "node scripts/version.mjs",
    "dev": "tauri dev",
    "build:exe": "tauri build --no-bundle && node scripts/pack-exe.mjs",
    "build": "node scripts/fetch-easytier.mjs && npm run build:exe && node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
