{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snake-army",
  "version": "0.2.1",
  "identifier": "com.krisurjw.snakearmy",
  "build": {
    "beforeDevCommand": "node scripts/sync-web.mjs",
    "beforeBuildCommand": "node scripts/sync-web.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "贪吃蛇 · 联机对战",
        "width": 920,
        "height": 940,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}
